# ==================================================
# Ghostty — AURORA COCKPIT
# Dark Glass / Electric Cyan / Neon Violet
# ==================================================

# --------------------------------------------------
# Font
# --------------------------------------------------

font-family = UDEV Gothic NF
font-size = 14

# macOSで少しだけ文字を太くする
font-thicken = true
font-thicken-strength = 16


# --------------------------------------------------
# Base Colors
# --------------------------------------------------

background = #05070D
foreground = #E6EEF8


# --------------------------------------------------
# Cursor / Selection / Mouse
# --------------------------------------------------

cursor-color = #59E1FF
cursor-style = bar
cursor-style-blink = true

selection-background = #223A63
selection-foreground = #FFFFFF

# Keep the pointer out of the way while typing.
mouse-hide-while-typing = true

# Keep clipboard behavior safe and clean.
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true


# --------------------------------------------------
# ANSI Palette
# --------------------------------------------------

palette = 0=#05070D
palette = 1=#FF6384
palette = 2=#8FF0A4
palette = 3=#FFD166
palette = 4=#6C9DFF
palette = 5=#BE8CFF
palette = 6=#59E1FF
palette = 7=#E6EEF8
palette = 8=#5F6E86
palette = 9=#FF8AA4
palette = 10=#B3F7BE
palette = 11=#FFE29A
palette = 12=#9AB8FF
palette = 13=#D6B4FF
palette = 14=#8EEBFF
palette = 15=#FFFFFF


# --------------------------------------------------
# Glass Effect
# --------------------------------------------------

background-opacity = 0.86
background-blur = 30


# --------------------------------------------------
# Window / Session
# --------------------------------------------------

macos-titlebar-style = transparent
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true

# Restore windows, tabs and splits after Ghostty restarts.
window-save-state = always


# --------------------------------------------------
# Working Directory
# --------------------------------------------------

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-font-size = true


# --------------------------------------------------
# Shell Integration
# --------------------------------------------------

shell-integration = zsh

# Preserve Ghostty capabilities over interactive SSH.
shell-integration-features = ssh-env,ssh-terminfo

# Notify when a long-running command finishes while Ghostty is unfocused.
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify


# --------------------------------------------------
# Split Appearance
# --------------------------------------------------

split-divider-color = #315779
unfocused-split-opacity = 0.78
split-preserve-zoom = navigation


# --------------------------------------------------
# Split Keybindings
# --------------------------------------------------

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Move between splits.
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down

# Resize the active split.
keybind = ctrl+alt+shift+left=resize_split:left,20
keybind = ctrl+alt+shift+right=resize_split:right,20
keybind = ctrl+alt+shift+up=resize_split:up,20
keybind = ctrl+alt+shift+down=resize_split:down,20

# Normalize the current split layout.
keybind = cmd+alt+0=equalize_splits

# Temporarily maximize the active split.
keybind = cmd+shift+enter=toggle_split_zoom


# --------------------------------------------------
# Prompt Navigation
# --------------------------------------------------

# Jump between shell prompts instead of scrolling through long output.
keybind = cmd+alt+k=jump_to_prompt:-1
keybind = cmd+alt+j=jump_to_prompt:1


# --------------------------------------------------
# General Keybindings
# --------------------------------------------------

keybind = cmd+shift+p=toggle_command_palette
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size


# --------------------------------------------------
# Quick Terminal
# --------------------------------------------------

quick-terminal-position = top
quick-terminal-size = 42%
quick-terminal-screen = main
quick-terminal-animation-duration = 0.18
quick-terminal-autohide = true

keybind = global:ctrl+alt+g=toggle_quick_terminal
